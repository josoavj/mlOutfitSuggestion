<swrl:Variable rdf:about="urn:swrl#g1"/>

<swrl:Variable rdf:about="urn:swrl#g2"/>

<swrl:Variable rdf:about="urn:swrl#c1"/>

<swrl:Variable rdf:about="urn:swrl#c2"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Garment"/>
          <swrl:argument1 rdf:resource="urn:swrl#g1"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:ClassAtom>
              <swrl:classPredicate rdf:resource="#Garment"/>
              <swrl:argument1 rdf:resource="urn:swrl#g2"/>
            </swrl:ClassAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#hasPrimaryColor"/>
                  <swrl:argument1 rdf:resource="urn:swrl#g1"/>
                  <swrl:argument2 rdf:resource="urn:swrl#c1"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#hasPrimaryColor"/>
                      <swrl:argument1 rdf:resource="urn:swrl#g2"/>
                      <swrl:argument2 rdf:resource="urn:swrl#c2"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#harmonizesWith"/>
                          <swrl:argument1 rdf:resource="urn:swrl#c1"/>
                          <swrl:argument2 rdf:resource="urn:swrl#c2"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:DifferentIndividualsAtom>
                              <swrl:argument1 rdf:resource="urn:swrl#g1"/>
                              <swrl:argument2 rdf:resource="urn:swrl#g2"/>
                            </swrl:DifferentIndividualsAtom>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#colorCompatibleWith"/>
          <swrl:argument1 rdf:resource="urn:swrl#g1"/>
          <swrl:argument2 rdf:resource="urn:swrl#g2"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#CasualOccasion"/>
    <rdf:Description rdf:about="#WorkOccasion"/>
    <rdf:Description rdf:about="#MeetingOccasion"/>
    <rdf:Description rdf:about="#EventOccasion"/>
    <rdf:Description rdf:about="#SportOccasion"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Top"/>
    <rdf:Description rdf:about="#Bottom"/>
    <rdf:Description rdf:about="#Outerwear"/>
    <rdf:Description rdf:about="#Dress"/>
    <rdf:Description rdf:about="#Shoes"/>
    <rdf:Description rdf:about="#Accessory"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
