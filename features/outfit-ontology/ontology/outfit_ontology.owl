<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://mloutfitsuggestion.local/ontology/outfit.owl"
         xmlns="http://mloutfitsuggestion.local/ontology/outfit.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://mloutfitsuggestion.local/ontology/outfit.owl">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ontologie du domaine vestimentaire pour mlOutfitSuggestion — catégories, couleurs, formalité, occasions, et règles de compatibilité entre pièces.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1.0</owl:versionInfo>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasPrimaryColor">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#Color"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSecondaryColor">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#Color"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMaterial">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#Material"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPattern">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#Pattern"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#suitableForSeason">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#Season"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#suitableForBodyShape">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#BodyShape"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasStyle">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#StyleTag"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isPartOf">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#Outfit"/>
  <owl:inverseOf rdf:resource="#hasPart"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPart">
  <rdfs:domain rdf:resource="#Outfit"/>
  <rdfs:range rdf:resource="#Garment"/>
  <owl:inverseOf rdf:resource="#isPartOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#harmonizesWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Color"/>
  <rdfs:range rdf:resource="#Color"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#colorCompatibleWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="#Garment"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#formalityLevel">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#warmthLevel">
  <rdfs:domain rdf:resource="#Garment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#requiresMinFormality">
  <rdfs:domain rdf:resource="#Occasion"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

